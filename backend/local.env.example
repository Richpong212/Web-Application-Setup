APP_PORT=5009
APP_HOST=localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5430
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-your-database-password

# Shared by the local backend and docker compose --env-file backend/local.env.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-your-redis-password
REDIS_CACHE_ENABLED=true
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_KEY_PREFIX=rp-ranch:local
REDIS_DEFAULT_TTL_SECONDS=60

JWT_SECRET=replace-with-a-long-random-secret
# 32 random bytes encoded as 64 hexadecimal characters (legacy encryption helper).
SECRET_KEY=replace-with-a-64-character-hexadecimal-key
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=rp_ranch_session
AUTH_COOKIE_SAME_SITE=strict
LOGIN_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_EMAIL=noreply@rp-ranch.test
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM_NAME=RP Ranch
SMTP_AUTH_ENABLED=false
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false

# Optional pending signup. No user is created until the approval link is confirmed.
# SEED_USER_NAME=Development Farmer
# SEED_USER_EMAIL=farmer@rp-ranch.test
# SEED_USER_PASSWORD=replace-with-a-strong-development-password

# Broad flood protection; normal session traffic has no strict auth budget.
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=3000
# Comma-separated proxy IPs/CIDRs. Set only to your actual ingress addresses.
TRUSTED_PROXIES=
